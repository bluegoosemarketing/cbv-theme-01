{%- comment -%}
  Reusable line item property block for packing slips / order printer templates.
  Usage inside a line item loop:
    {% render 'packing-slip-line-item-properties', line_item: line_item %}
{%- endcomment -%}
{%- assign property_size = line_item.properties | size -%}
{%- if property_size > 0 -%}
  <div class="cbv-packing-slip-properties">
    {%- for property in line_item.properties -%}
      {%- liquid
        assign property_first_char = property.first | slice: 0
        assign hide_property = false
        if property.first == 'wick_upgrade'
          for option in line_item.options_with_values
            if option.name == 'Wick Upgrade'
              assign hide_property = true
              break
            endif
          endfor
        endif
      -%}
      {%- if property.last != blank and property_first_char != '_' and hide_property == false -%}
        {%- liquid
          assign property_label = property.first
          if property.first == 'wax_color'
            assign property_label = 'Wax color'
          elsif property.first == 'scent_family'
            assign property_label = 'Family'
          elsif property.first == 'scent_selection'
            assign property_label = 'Scents'
          elsif property.first contains 'scent_'
            assign scent_index = property.first | remove: 'scent_'
            if scent_index == '1'
              assign property_label = 'Scent'
            else
              assign property_label = 'Scent ' | append: scent_index
            endif
          elsif property.first == 'wick_upgrade'
            assign property_label = 'Wick Upgrade'
          endif
        -%}
        <div>
          <strong>{{ property_label }}:</strong>
          {%- if property.last contains '/uploads/' -%}
            <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
          {%- else -%}
            {{ property.last }}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
