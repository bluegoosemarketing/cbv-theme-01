      margin: 20px 0 10px; display: block; border-bottom: 1px solid var(--cbv-border-color); padding-bottom: 5px;
    }
    .cbv-mob-sub-title {
      font-size: 11px; font-family: var(--font-body); text-transform: uppercase; letter-spacing: 0.1em;
      color: #888; font-weight: 500; margin: 15px 0 8px; display: block; padding-left: 10px;
    }
    .cbv-mob-link {
      font-size: 15px; font-family: var(--font-body); display: block; padding: 8px 0; color: #5C534D; text-decoration: none;
    }
    .cbv-mob-link-sub {
      font-size: 14px; font-family: var(--font-body); display: block; padding: 6px 0 6px 10px;
      color: #5C534D; border-left: 2px solid transparent; text-decoration: none; transition: color 0.2s;
    }
    .cbv-mob-link-sub:hover {
      color: var(--cbv-header-accent); border-left-color: var(--cbv-header-accent);
    }
    .cbv-mobile-divider {
      height: 1px; background: var(--cbv-border-color); margin: 15px 0; width: 100%; display: block;
    }
    .cbv-mobile-scent-grid {
      display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 15px;
    }
    .cbv-mobile-scent-grid .cbv-scent-pill { background: #FFFFFF; border-color: var(--cbv-border-color); }
    .cbv-drawer-footer {
      margin-top: 30px; padding-top: 25px; border-top: 1px solid var(--cbv-border-color); text-align: center;
    }
    .cbv-drawer-footer a {
      display: block; padding: 10px; font-size: 13px; font-family: var(--font-body); color: #5C534D; text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;
    }
  }

  #shopify-section-header, 
  .shopify-section-header, 
  .section-header {
    position: relative !important;
    z-index: 99999 !important;
  }

  .cbv-lib-controls {
    z-index: 10 !important; 
  }

  /* --- MINIMAL BUILDER HEADER (The "Checkout Flow" Focus) --- */
  .cbv-header-fixed-group--minimal {
    background: var(--cbv-body-bg);
  }

  .cbv-header-fixed-group--minimal .cbv-header {
    padding: 0 40px;
  }

  .cbv-header-fixed-group--minimal .cbv-header-top {
    padding: 8px 0;
    min-height: 64px;
  }

  .cbv-header-fixed-group--minimal .cbv-builder-exit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #888;
    text-decoration: none;
    font-size: 12px;
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .cbv-header-fixed-group--minimal .cbv-builder-exit:hover {
    color: var(--cbv-header-text);
    transform: translateX(-3px);
  }

  .cbv-header-fixed-group--minimal .cbv-icons {
    gap: 0;
  }

  .cbv-flow-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 2px;
    border: 1px solid var(--cbv-header-accent);
    background: var(--cbv-header-accent);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .cbv-flow-cta:hover {
    transform: translateY(-1px);
    background-color: var(--cbv-header-accent-hover);
    border-color: var(--cbv-header-accent-hover);
  }

  .cbv-header-fixed-group--cart .cbv-builder-progress {
    background: rgba(130, 142, 125, 0.1);
  }

  .cbv-header-fixed-group--cart .cbv-cart-count {
    display: none;
  }

  .cbv-header-fixed-group--minimal.is-scrolled .cbv-header-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: auto;
    padding: 8px 0;
    pointer-events: auto;
  }

  .cbv-header-fixed-group--minimal.is-scrolled .cbv-logo-center {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    height: auto;
    overflow: visible;
  }

  .cbv-header-fixed-group--minimal.is-scrolled .cbv-logo-sticky {
    opacity: 0;
    width: 0;
    overflow: hidden;
  }

  .cbv-header-fixed-group--minimal.is-scrolled .cbv-header-left,
  .cbv-header-fixed-group--minimal.is-scrolled .cbv-icons {
    pointer-events: auto;
  }

  @media (max-width: 1024px) {
    .cbv-header-fixed-group--minimal .cbv-header {
      padding: 0 20px;
      height: 64px;
      border-bottom: 1px solid var(--cbv-border-color);
    }

    .cbv-header-fixed-group--minimal .cbv-mobile-header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      column-gap: 8px;
    }

    .cbv-header-fixed-group--minimal .cbv-mobile-logo {
      flex: initial;
      min-width: 0;
    }

    .cbv-header-fixed-group--minimal .cbv-mobile-logo .cbv-builder-progress {
      display: block; 
      margin-top: 4px;
      font-size: 8px;
      letter-spacing: 0.1em;
      padding: 3px 8px;
    }

    .cbv-header-fixed-group--minimal .cbv-mobile-icons {
      justify-content: flex-end;
    }

    .cbv-header-fixed-group--minimal .cbv-builder-exit {
      font-size: 11px;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }
    
    .cbv-header-fixed-group--minimal .cbv-builder-exit span { display: none; } 
  }
{% endstyle %}

