{%- comment -%}
  Subscription dashboard for customer-owned Recharge subscriptions.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .cbv-subscriptions {
    max-width: 108rem;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .cbv-subscriptions__header {
    margin-bottom: 2.4rem;
  }

  .cbv-subscriptions__eyebrow {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: 0.16rem;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.62);
  }

  .cbv-subscriptions__title {
    margin: 0.8rem 0 0;
    font-size: clamp(2.8rem, 4vw, 4rem);
    line-height: 1.05;
  }

  .cbv-subscriptions__subtitle {
    margin: 1.2rem 0 0;
    max-width: 64rem;
    color: rgba(var(--color-foreground), 0.72);
  }

  .cbv-subscriptions__list {
    display: grid;
    gap: 1.6rem;
  }

  .cbv-subscriptions-card {
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    border-radius: 1.6rem;
    background: rgba(var(--color-background), 0.98);
    box-shadow: 0 0.8rem 2.6rem rgba(0, 0, 0, 0.04);
    padding: 2rem;
    display: grid;
    gap: 1.6rem;
  }

  .cbv-subscriptions-card__top {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .cbv-subscriptions-card__name {
    margin: 0;
    font-size: 2.1rem;
    line-height: 1.2;
  }

  .cbv-subscriptions-card__type {
    margin-top: 0.8rem;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
    background: rgba(var(--color-foreground), 0.07);
  }

  .cbv-subscriptions-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .cbv-subscriptions-card__status-dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: currentColor;
  }

  .cbv-subscriptions-card__status--active {
    color: #1b7f3b;
    background: rgba(27, 127, 59, 0.14);
  }

  .cbv-subscriptions-card__status--paused {
    color: #8f5c00;
    background: rgba(143, 92, 0, 0.16);
  }

  .cbv-subscriptions-card__meta {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cbv-subscriptions-card__meta-item {
    border-radius: 1rem;
    background: rgba(var(--color-foreground), 0.04);
    padding: 1rem 1.2rem;
  }

  .cbv-subscriptions-card__meta-label {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: 0.08rem;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.62);
  }

  .cbv-subscriptions-card__meta-value {
    margin: 0.35rem 0 0;
    font-weight: 600;
    line-height: 1.35;
  }

  .cbv-subscriptions-card__config {
    margin: 0;
    padding: 1.1rem 1.3rem;
    border-left: 0.3rem solid rgba(var(--color-foreground), 0.25);
    border-radius: 0.8rem;
    background: rgba(var(--color-foreground), 0.03);
    color: rgba(var(--color-foreground), 0.84);
  }

  .cbv-subscriptions-card__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .cbv-subscriptions-card__actions .button {
    width: 100%;
    min-height: 4rem;
  }

  .cbv-subscriptions__empty {
    padding: 2.8rem 2rem;
    text-align: center;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.2);
    border-radius: 1.6rem;
    background: rgba(var(--color-foreground), 0.03);
  }

  .cbv-subscriptions__empty h2 {
    margin-top: 0;
    margin-bottom: 0.8rem;
  }

  .cbv-subscriptions__empty p {
    margin: 0 auto 1.8rem;
    max-width: 48rem;
    color: rgba(var(--color-foreground), 0.72);
  }

  .cbv-subscriptions__status {
    margin: 0 0 1.6rem;
    padding: 1rem 1.2rem;
    border-radius: 1rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.1);
    background: rgba(var(--color-foreground), 0.03);
    color: rgba(var(--color-foreground), 0.78);
  }

  .cbv-subscriptions__status[hidden] {
    display: none !important;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .cbv-subscriptions__header {
      margin-bottom: 3.2rem;
    }

    .cbv-subscriptions-card {
      padding: 2.4rem;
      gap: 2rem;
    }

    .cbv-subscriptions-card__meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .cbv-subscriptions-card__actions {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <section class="cbv-subscriptions section-{{ section.id }}-padding" aria-labelledby="cbv-subscriptions-title">
    <header class="cbv-subscriptions__header">
      <p class="cbv-subscriptions__eyebrow">Candle Club</p>
      <h1 id="cbv-subscriptions-title" class="cbv-subscriptions__title heading-bold">My Subscriptions</h1>
      <p class="cbv-subscriptions__subtitle">
        Manage your recurring candle and wax melt deliveries in one place. Update billing, skip, pause, or prep your next scent drop.
      </p>
    </header>

    {%- if customer -%}
      <p class="cbv-subscriptions__status" data-cbv-subscriptions-status aria-live="polite">Loading your subscriptions…</p>
      <div class="cbv-subscriptions__list" data-cbv-subscriptions-list></div>
      <script type="application/json" data-cbv-subscriptions-api-config>
        {
          "api_base_path": {{ section.settings.api_base_path | strip | default: '/apps/cbv-subscriptions' | json }},
          "empty_state_enabled": {{ section.settings.show_empty_state | json }},
          "data_mode": {{ section.settings.data_mode | default: 'mock' | json }}
        }
      </script>
      <script type="application/json" data-cbv-subscriptions-mock-items>
        {
          "items": [
            {
              "id": "mock-candle-1",
              "subscription_name": "Custom Candle Club",
              "status": "Active",
              "builder_family": "candle",
              "builder_type": "Candle",
              "next_charge_date": "April 18, 2026",
              "frequency": "Every 30 days",
              "properties": {
                "scent_1": "Vanilla Bean",
                "wax_color": "White Wax",
                "vessel": "18oz Jar",
                "wick_upgrade": "Standard"
              }
            },
            {
              "id": "mock-wax-1",
              "subscription_name": "Wax Melt Club",
              "status": "Paused",
              "builder_family": "wax-melt",
              "builder_type": "Wax Melt",
              "next_charge_date": "May 2, 2026",
              "frequency": "Every 45 days",
              "product_context": {
                "secondary_prop_key": "pack_size"
              },
              "properties": {
                "scent_1": "Lavender",
                "vessel_format": "Clamshell",
                "pack_size": "6-pack"
              }
            }
          ]
        }
      </script>
    {%- else -%}
      <div class="cbv-subscriptions__empty">
        <h2 class="heading-bold">Sign in to manage subscriptions</h2>
        <p>Please sign in to load your Candle Club and wax melt subscription items.</p>
        <a class="button button--primary" href="/account/login">Sign in</a>
      </div>
    {%- endif -%}
  </section>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-cbv-subscriptions-list]')?.closest('[aria-labelledby="cbv-subscriptions-title"]');
    if (!root) return;

    const statusEl = root.querySelector('[data-cbv-subscriptions-status]');
    const listEl = root.querySelector('[data-cbv-subscriptions-list]');
    const configScript = root.querySelector('[data-cbv-subscriptions-api-config]');
    const mocksScript = root.querySelector('[data-cbv-subscriptions-mock-items]');

    function readConfig() {
      try {
        return JSON.parse(configScript?.textContent || '{}');
      } catch (error) {
        console.error('CBV subscriptions: invalid API config JSON', error);
        return {};
      }
    }

    function readMocks() {
      try {
        return JSON.parse(mocksScript?.textContent || '{"items":[]}');
      } catch (error) {
        console.error('CBV subscriptions: invalid mock JSON', error);
        return { items: [] };
      }
    }

    function escapeHtml(value) {
      return (value || '').toString().replace(/[&<>"']/g, (char) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char] || char
      ));
    }

    function normalizeFamily(value) {
      const normalized = (value || '').toString().trim().toLowerCase();
      return normalized === 'wax melt' ? 'wax-melt' : normalized;
    }

    function summaryForItem(item) {
      const props = item.properties || {};
      const builderFamily = normalizeFamily(item.builder_family);
      if (builderFamily === 'wax-melt') {
        const secondaryKey = item.product_context?.secondary_prop_key;
        return [props.scent_1, props.vessel_format, secondaryKey ? props[secondaryKey] : ''].filter(Boolean).join(' · ');
      }
      return [props.scent_1, props.wax_color, props.vessel, props.wick_upgrade].filter(Boolean).join(' · ');
    }

    function renderCard(item) {
      const builderFamily = normalizeFamily(item.builder_family);
      const builderType = item.builder_type || (builderFamily === 'wax-melt' ? 'Wax Melt' : 'Candle');
      const status = (item.status || 'Active').toString();
      const statusClass = status.toLowerCase() === 'paused'
        ? 'cbv-subscriptions-card__status--paused'
        : 'cbv-subscriptions-card__status--active';
      const id = encodeURIComponent(item.id || '');
      const type = encodeURIComponent(builderFamily || 'candle');
      const summary = summaryForItem(item) || 'Configuration details available soon.';

      return `
        <article class="cbv-subscriptions-card" aria-label="${escapeHtml(item.subscription_name || item.product_title || 'Subscription item')}">
          <div class="cbv-subscriptions-card__top">
            <div>
              <h2 class="cbv-subscriptions-card__name heading-bold">${escapeHtml(item.subscription_name || item.product_title || 'Subscription item')}</h2>
              <span class="cbv-subscriptions-card__type">${escapeHtml(builderType)}</span>
            </div>
            <span class="cbv-subscriptions-card__status ${statusClass}">
              <span class="cbv-subscriptions-card__status-dot" aria-hidden="true"></span>
              ${escapeHtml(status)}
            </span>
          </div>
          <div class="cbv-subscriptions-card__meta">
            <div class="cbv-subscriptions-card__meta-item">
              <p class="cbv-subscriptions-card__meta-label">Next charge</p>
              <p class="cbv-subscriptions-card__meta-value">${escapeHtml(item.next_charge_date || '—')}</p>
            </div>
            <div class="cbv-subscriptions-card__meta-item">
              <p class="cbv-subscriptions-card__meta-label">Frequency</p>
              <p class="cbv-subscriptions-card__meta-value">${escapeHtml(item.frequency || '—')}</p>
            </div>
            <div class="cbv-subscriptions-card__meta-item">
              <p class="cbv-subscriptions-card__meta-label">Builder flow</p>
              <p class="cbv-subscriptions-card__meta-value">${escapeHtml(builderType)} Builder</p>
            </div>
          </div>
          <p class="cbv-subscriptions-card__config">${escapeHtml(summary)}</p>
          <div class="cbv-subscriptions-card__actions" aria-label="Subscription actions">
            <a class="button button--secondary" href="${escapeHtml(item.billing_management_url || '#')}">Manage Billing</a>
            <a class="button button--secondary" href="/pages/edit-subscription-item?type=${type}&id=${id}">Edit Next Item</a>
            <a class="button button--secondary" href="#">Skip Next Order</a>
            <a class="button button--secondary" href="#">Pause Subscription</a>
          </div>
        </article>
      `;
    }

    async function init() {
      const config = readConfig();
      const mocks = readMocks();
      const mode = (config.data_mode || 'mock').toLowerCase();
      const apiBasePath = (config.api_base_path || '/apps/cbv-subscriptions').replace(/\/$/, '');
      const mockItems = Array.isArray(mocks?.items) ? mocks.items : [];

      function renderItems(items, source) {
        if (items.length === 0) {
          if (config.empty_state_enabled) {
            listEl.innerHTML = `<div class="cbv-subscriptions__empty"><h2 class="heading-bold">No subscriptions yet</h2><p>It looks like you do not have any active subscription items right now.</p></div>`;
          } else {
            listEl.innerHTML = '';
          }
          statusEl.hidden = true;
          return;
        }

        listEl.innerHTML = items.map(renderCard).join('');
        statusEl.hidden = source !== 'mock-fallback';
        if (source === 'mock-fallback') {
          statusEl.textContent = 'Live subscriptions are temporarily unavailable. Showing demo subscriptions.';
        }
      }

      if (mode === 'mock') {
        renderItems(mockItems, 'mock');
        return;
      }

      try {
        const response = await fetch(`${apiBasePath}/items`, {
          method: 'GET',
          headers: { Accept: 'application/json' },
          credentials: 'same-origin'
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload = await response.json();
        const items = Array.isArray(payload?.items) ? payload.items : [];
        renderItems(items, 'live');
      } catch (error) {
        console.error('CBV subscriptions: failed to load customer subscription items', error);
        if (mode === 'auto') {
          renderItems(mockItems, 'mock-fallback');
          return;
        }
        statusEl.hidden = false;
        statusEl.textContent = 'We could not load your live subscriptions right now. Please refresh and try again.';
      }
    }

    init();
  })();
</script>

{% schema %}
{
  "name": "CBV manage subscriptions",
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "option-1"
    },
    {
      "type": "checkbox",
      "id": "show_empty_state",
      "label": "Show empty state",
      "default": false
    },
    {
      "type": "select",
      "id": "data_mode",
      "label": "Subscription data mode",
      "default": "mock",
      "options": [
        {
          "value": "mock",
          "label": "Mock (safe default)"
        },
        {
          "value": "live",
          "label": "Live API only"
        },
        {
          "value": "auto",
          "label": "Auto (live, fallback to mock)"
        }
      ]
    },
    {
      "type": "text",
      "id": "api_base_path",
      "label": "Subscriptions API base path",
      "default": "/apps/cbv-subscriptions",
      "info": "Theme will call {base}/items for customer-owned subscription items."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ]
}
{% endschema %}
