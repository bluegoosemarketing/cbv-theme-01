    {
      "type": "liquid",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Shop by <em>Collection</em>",
      "info": "Supports HTML, including <em> tags."
    }
  ],
  "blocks": [
    {
      "type": "category_item",
      "name": "Category Item",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "category_image",
          "label": "Category Image"
        },
        {
          "type": "text",
