        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Custom Candles"
        },
        {
          "type": "text",
          "id": "feature_1_text",
          "label": "Feature 1 Text",
          "default": "Choose your jar"
        },
        {
          "type": "text",
          "id": "feature_2_text",
          "label": "Feature 2 Text",
          "default": "Pick a wax color"
        },
        {
          "type": "text",
          "id": "feature_3_text",
          "label": "Feature 3 Text",
          "default": "Select your scent"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Wayfinding Grid",
      "blocks": [
        {
          "type": "category_item",
          "settings": {
            "eyebrow_text": "Hand-Poured For You",
            "title": "Custom Candles",
            "feature_1_text": "Choose your jar",
            "feature_2_text": "Pick a wax color",
            "feature_3_text": "Select your scent"
          }
        },
        {
          "type": "category_item",
          "settings": {
            "eyebrow_text": "Flameless Fragrance",
            "title": "Custom Wax Melts",
            "feature_1_text": "Choose a shape",
            "feature_2_text": "Select your scent",
            "feature_3_text": "Hand-poured detail"
          }
        },
        {
          "type": "category_item",
          "settings": {
            "eyebrow_text": "Artisan Designs",
            "title": "Signature Lines",
            "feature_1_text": "The Bake Shoppe",
            "feature_2_text": "The Cuties",
            "feature_3_text": "Sweet Treats"
          }
        },
        {
          "type": "category_item",
          "settings": {
            "eyebrow_text": "Find Your Favorite",
            "title": "Scent Shots",
            "feature_1_text": "2oz wax samplers",
            "feature_2_text": "Over 800 fragrances",
            "feature_3_text": "Build a multi-pack"
          }
        }
      ]
    }
  ]
}
{% endschema %}
