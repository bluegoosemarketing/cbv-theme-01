{{ 'section-cbv-collection-format-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign featured_collection = section.settings.best_sellers_collection
  if featured_collection == blank
    assign featured_collection = collection
  endif
  assign sidebar_menu = section.settings.sidebar_menu
  assign current_path = request.path
  assign template_suffix_normalized = template.suffix | default: '' | downcase | replace: '_', '-'
  assign hide_intro = false
  if template_suffix_normalized == 'general-grid' or template_suffix_normalized == 'wax-melts'
    assign hide_intro = true
  elsif template_suffix_normalized contains 'bath' and template_suffix_normalized contains 'body'
    assign hide_intro = true
  endif
-%}

<section class="cbv-format-grid section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="cbv-format-grid__layout {% if sidebar_menu != blank and sidebar_menu.links.size > 0 %}has-sidebar{% endif %}">
      
      {%- if sidebar_menu != blank and sidebar_menu.links.size > 0 -%}
        <aside class="cbv-format-grid__sidebar" aria-label="{{ section.settings.sidebar_heading | escape }}">
          {%- if section.settings.sidebar_heading != blank -%}
            <p class="cbv-format-grid__sidebar-heading">{{ section.settings.sidebar_heading | escape }}</p>
          {%- endif -%}
          <nav class="cbv-format-grid__sidebar-nav">
            <ul class="cbv-format-grid__sidebar-list list-unstyled" role="list">
              {%- for link in sidebar_menu.links -%}
                {%- liquid
                  assign link_path = link.url | split: '?' | first
                  assign is_active_link = false
                  if current_path == link_path
                    assign is_active_link = true
                  elsif link.type == 'collection_link' and collection and link.object and link.object.handle == collection.handle
                    assign is_active_link = true
                  elsif link.type == 'product_link' and product and link.object and link.object.handle == product.handle
                    assign is_active_link = true
                  endif
                -%}
                <li>
                  <a href="{{ link.url }}" class="cbv-format-grid__nav-link{% if is_active_link %} is-active{% endif %}" {% if is_active_link %}aria-current="page"{% endif %}>
                    <span>{{ link.title | escape }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </aside>
      {%- endif -%}

      <div class="cbv-format-grid__main">
        {%- if sidebar_menu != blank and sidebar_menu.links.size > 0 -%}
          <nav class="cbv-format-grid__mobile-nav" aria-label="{{ section.settings.sidebar_heading | escape }}">
            <ul class="cbv-format-grid__mobile-nav-list list-unstyled" role="list">
              {%- for link in sidebar_menu.links -%}
                {%- liquid
                  assign link_path = link.url | split: '?' | first
                  assign is_active_link = false
                  if current_path == link_path
                    assign is_active_link = true
                  elsif link.type == 'collection_link' and collection and link.object and link.object.handle == collection.handle
                    assign is_active_link = true
                  elsif link.type == 'product_link' and product and link.object and link.object.handle == product.handle
                    assign is_active_link = true
                  endif
                -%}
                <li>
                  <a href="{{ link.url }}" class="cbv-format-grid__mobile-chip{% if is_active_link %} is-active{% endif %}" {% if is_active_link %}aria-current="page"{% endif %}>
                    {{ link.title | escape }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <div class="cbv-format-grid__top-bar">
          <div class="cbv-format-grid__header-text">
            {%- assign display_title = collection.metafields.theme.display_title | default: collection.title -%}
            {%- assign display_description = collection.metafields.theme.display_description | default: collection.description -%}
            <h1 class="cbv-format-grid__title">{{ display_title | escape }}</h1>
            {%- unless hide_intro -%}
              {%- if display_description != blank -%}
                <div class="cbv-format-grid__intro rte">{{ display_description }}</div>
              {%- elsif section.settings.intro != blank -%}
                <div class="cbv-format-grid__intro rte">{{ section.settings.intro }}</div>
              {%- endif -%}
            {%- endunless -%}
          </div>

          <div class="cbv-format-grid__toolbar">
            <div class="cbv-quick-search">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
              </svg>
              <input type="text" id="cbv-format-search" placeholder="Search {{ collection.title | escape }}" aria-label="Search {{ collection.title | escape }}">
            </div>
            <div class="cbv-sort-select">
              <label class="visually-hidden" for="cbv-format-sort">Sort by</label>
              <select id="cbv-format-sort" name="sort_by" aria-label="Sort products">
                {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>
                    {{ option.name | escape }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          </div>
        </div>

        <div
          class="cbv-format-grid__cards{% if section.settings.mobile_columns == '2' %} cbv-format-grid__cards--mobile-2{% endif %}"
          id="cbv-format-cards"
          role="list"
        >
      {%- if section.settings.card_source == 'collection_products' -%}
        {%- paginate collection.products by 1000 -%}
        {%- for product in collection.products -%}
          {%- liquid
            assign card_title = product.title
            assign card_link = product.url
            assign card_description = product.description | strip_html | truncatewords: section.settings.description_word_limit
            assign has_builder_tag = false
            for tag in product.tags
              assign normalized_tag = tag | downcase
              if normalized_tag == 'builder'
                assign has_builder_tag = true
                break
              endif
            endfor
            assign can_quick_add = false
            if section.settings.enable_quick_add and product.has_only_default_variant and product.available and has_builder_tag == false
              assign can_quick_add = true
            endif
          -%}

          <div class="cbv-format-card{% if can_quick_add %} cbv-format-card--with-quick-add{% endif %}" role="listitem">
            <a href="{{ card_link }}" class="cbv-format-card__link">
              <div class="cbv-format-card__media">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '280, 420, 560, 720, 900',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                      class: 'cbv-format-card__image',
                      alt: card_title
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'cbv-format-card__placeholder' }}
                {%- endif -%}
              </div>

              <div class="cbv-format-card__content">
                <h2 class="cbv-format-card__title">{{ card_title | escape }}</h2>
                {%- if card_description != blank -%}
                  <p class="cbv-format-card__description">{{ card_description }}</p>
                {%- endif -%}
              </div>
            </a>

            <div class="cbv-format-card__footer">
              {%- if can_quick_add -%}
                {%- form 'product', product, class: 'cbv-format-card__form' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" name="add" class="cbv-format-card__action-btn cbv-format-card__action-btn--primary">
                    <span class="cbv-format-card__btn-text">Add to Cart</span>
                    <span class="cbv-format-card__btn-price">
                      <span class="cbv-format-card__price-text">{{ product.price | money }}</span>
                      <svg class="cbv-format-card__spinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                      </svg>
                      <svg class="cbv-format-card__check" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                    </span>
                  </button>
                {%- endform -%}
              {%- else -%}
                <a href="{{ card_link }}" class="cbv-format-card__action-btn cbv-format-card__action-btn--{% if product.available == false %}secondary{% else %}primary{% endif %}" {% if product.available == false %}disabled{% endif %}>
                  <span class="cbv-format-card__btn-text">{% if product.available == false %}Sold Out{% else %}View Details{% endif %}</span>
                  {%- if product.available -%}
                    <span class="cbv-format-card__btn-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" />
                      </svg>
                    </span>
                  {%- endif -%}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endpaginate -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_title = block.settings.title | default: block.settings.format_size
            assign card_link = block.settings.link
            assign card_cta = block.settings.cta_label | default: section.settings.default_cta_label
            assign card_description = block.settings.description | strip_html | truncatewords: section.settings.description_word_limit
          -%}

          <div class="cbv-format-card" {{ block.shopify_attributes }} role="listitem">
            {%- if card_link != blank -%}
              <a href="{{ card_link }}" class="cbv-format-card__link">
            {%- else -%}
              <div class="cbv-format-card__link">
            {%- endif -%}
              <div class="cbv-format-card__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '280, 420, 560, 720, 900',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                      class: 'cbv-format-card__image',
                      alt: card_title
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'cbv-format-card__placeholder' }}
                {%- endif -%}
              </div>

              <div class="cbv-format-card__content">
                <h2 class="cbv-format-card__title">{{ card_title | escape }}</h2>
                {%- if card_description != blank -%}
                  <p class="cbv-format-card__description">{{ card_description }}</p>
                {%- endif -%}
              </div>
            {%- if card_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}

            <div class="cbv-format-card__footer">
              <a {% if card_link != blank %}href="{{ card_link }}"{% endif %} class="cbv-format-card__action-btn cbv-format-card__action-btn--primary">
                <span class="cbv-format-card__btn-text">{{ card_cta | escape }}</span>
                <span class="cbv-format-card__btn-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" />
                  </svg>
                </span>
              </a>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

          <div id="cbv-format-empty" class="cbv-format-empty-state">
            No {{ collection.title | escape }} products matched your search. Try another term!
          </div>
        </div>

        {%- if section.settings.show_best_sellers and featured_collection != blank and featured_collection.products_count > 0 -%}
          <div class="cbv-format-grid__best-sellers">
            <div class="cbv-format-grid__best-sellers-header">
              <h2>{{ section.settings.best_sellers_heading | escape }}</h2>
            </div>

            <div class="cbv-format-grid__best-sellers-list" role="list">
              {%- for product in featured_collection.products limit: section.settings.best_sellers_limit -%}
                <a href="{{ product.url }}" class="cbv-best-seller" role="listitem">
                  <div class="cbv-best-seller__media">
                    {%- if product.featured_media -%}
                      {{
                        product.featured_media
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          widths: '160, 260, 360, 520, 600',
                          sizes: '(min-width: 990px) 20vw, 45vw',
                          class: 'cbv-best-seller__image',
                          alt: product.title
                      }}
                    {%- endif -%}
                  </div>
                  <div class="cbv-best-seller__content">
                    <h3>{{ product.title | escape }}</h3>
                    <p>{{ product.price | money }}</p>
                    <span>{{ section.settings.best_sellers_cta_label | escape }}</span>
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% comment %} Script for Instant Quick Search Filter and Custom AJAX Cart {% endcomment %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // --- SCENT PARAMETER FORWARDING ---
    const scentParam = new URLSearchParams(window.location.search).get('scent');
    const appendScentParam = (url) => {
      if (!url || !scentParam) return url;
      const [base, hash = ''] = url.split('#');
      if (!base) return url;

      try {
        const parsedUrl = new URL(base, window.location.origin);
        parsedUrl.searchParams.set('scent', scentParam);
        const nextUrl = `${parsedUrl.pathname}${parsedUrl.search}`;
        return hash ? `${nextUrl}#${hash}` : nextUrl;
      } catch (error) {
        return url;
      }
    };

    if (scentParam) {
      document.querySelectorAll('.cbv-format-card__link[href], .cbv-format-card__action-btn[href], .cbv-best-seller[href], .cbv-format-grid__nav-link[href], .cbv-format-grid__mobile-chip[href]').forEach((link) => {
        link.href = appendScentParam(link.getAttribute('href'));
      });
    }

    // --- QUICK SEARCH ---
    const searchInput = document.getElementById('cbv-format-search');
    const sortSelect = document.getElementById('cbv-format-sort');
    const cards = document.querySelectorAll('.cbv-format-card');
    const emptyState = document.getElementById('cbv-format-empty');

    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const term = e.target.value.toLowerCase().trim();
        let visibleCount = 0;

        cards.forEach(card => {
          const title = card.querySelector('.cbv-format-card__title').textContent.toLowerCase();
          const desc = card.querySelector('.cbv-format-card__description')?.textContent.toLowerCase() || '';
          
          if (title.includes(term) || desc.includes(term)) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0) {
          emptyState.style.display = 'block';
        } else {
          emptyState.style.display = 'none';
        }
      });
    }

    // --- COLLECTION SORT ---
    if (sortSelect) {
      sortSelect.addEventListener('change', function(e) {
        const nextSort = e.target.value;
        const url = new URL(window.location.href);

        if (nextSort) {
          url.searchParams.set('sort_by', nextSort);
        } else {
          url.searchParams.delete('sort_by');
        }

        window.location.href = url.toString();
      });
    }

    // --- CUSTOM AJAX ADD TO CART ---
    const addToCartForms = document.querySelectorAll('.cbv-format-card__form');
    
    addToCartForms.forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const btn = form.querySelector('button[type="submit"]');
        const textSpan = btn.querySelector('.cbv-format-card__btn-text');
        const originalText = textSpan.textContent;

        // Set Loading State
        btn.classList.add('is-loading');
        textSpan.textContent = 'Adding...';

        try {
          const formData = new FormData(form);
          const rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
          const addUrl = rootUrl + (rootUrl.endsWith('/') ? 'cart/add.js' : '/cart/add.js');
          
          // 1. Add item to cart
          const response = await fetch(addUrl, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });

          if (!response.ok) throw new Error('Failed to add to cart');

          // 2. Silently update the Cart Bubble Icon (if applicable)
          try {
            const bubbleUrl = rootUrl + (rootUrl.endsWith('/') ? '?section_id=cart-icon-bubble' : '/?section_id=cart-icon-bubble');
            const bubbleRes = await fetch(bubbleUrl);
            if (bubbleRes.ok) {
              const bubbleText = await bubbleRes.text();
              const html = new DOMParser().parseFromString(bubbleText, 'text/html');
              const newBubble = html.getElementById('shopify-section-cart-icon-bubble');
              const oldBubble = document.getElementById('shopify-section-cart-icon-bubble');
              if (newBubble && oldBubble) oldBubble.innerHTML = newBubble.innerHTML;
            }
          } catch(bubbleError) {
             // Continue even if bubble fails
          }

          // 3. Trigger Global Theme Events (opens drawer if theme supports it, updates state)
          if (window.publish && window.PUB_SUB_EVENTS) {
            window.publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'cbv-grid' });
          } else {
            document.documentElement.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
          }

          // 4. Set Success State
          btn.classList.remove('is-loading');
          btn.classList.add('is-added');
          textSpan.textContent = 'Added!';

          // 5. Revert after 2.5 seconds
          setTimeout(() => {
            btn.classList.remove('is-added');
            textSpan.textContent = originalText;
          }, 2500);

        } catch (error) {
          console.error(error);
          btn.classList.remove('is-loading');
          textSpan.textContent = 'Error';
          
          setTimeout(() => {
            textSpan.textContent = originalText;
          }, 2000);
        }
      });
    });

  });
</script>

{% schema %}
{
  "name": "CBV format grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings":[
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by format"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro copy",
      "default": "<p>Choose your vessel, then enter our candle builder to pour your scent memory.</p>"
    },
    {
      "type": "select",
      "id": "card_source",
      "label": "Card source",
      "default": "collection_products",
      "options":[
        {
          "value": "blocks",
          "label": "Section blocks"
        },
        {
          "value": "collection_products",
          "label": "Collection products"
        }
      ]
    },
    {
      "type": "text",
      "id": "default_cta_label",
      "label": "Default card CTA label",
      "default": "View Details"
    },
    {
      "type": "link_list",
      "id": "sidebar_menu",
      "label": "Sidebar navigation menu"
    },
    {
      "type": "text",
      "id": "sidebar_heading",
      "label": "Sidebar heading",
      "default": "Shop categories"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add to cart for single-variant products",
      "default": true
    },
    {
      "type": "range",
      "id": "collection_products_limit",
      "label": "Collection products to feature",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "description_word_limit",
      "label": "Collection product description length",
      "min": 5,
      "max": 40,
      "step": 1,
      "default": 10
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile product columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    },
    {
      "type": "header",
      "content": "Best sellers"
    },
    {
      "type": "checkbox",
      "id": "show_best_sellers",
      "label": "Show best sellers",
      "default": false
    },
    {
      "type": "text",
      "id": "best_sellers_heading",
      "label": "Best sellers heading",
      "default": "Loved right now"
    },
    {
      "type": "collection",
      "id": "best_sellers_collection",
      "label": "Collection source"
    },
    {
      "type": "range",
      "id": "best_sellers_limit",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "best_sellers_cta_label",
      "label": "Best sellers CTA label",
      "default": "Shop now"
    }
  ],
  "blocks":[
    {
      "type": "format_card",
      "name": "Format card",
      "settings":[
        {
          "type": "text",
          "id": "format_size",
          "label": "Format size",
          "default": "12oz Signature"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A refined everyday pour with balanced throw and burn time."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label"
        }
      ]
    }
  ],
  "presets":[
    {
      "name": "CBV format grid",
      "blocks":[
        {
          "type": "format_card",
          "settings": {
            "format_size": "12oz Signature",
            "description": "Perfect for kitchens, offices, and cozy corners."
          }
        },
        {
          "type": "format_card",
          "settings": {
            "format_size": "18oz Classic",
            "description": "A fuller throw for larger gathering spaces."
          }
        },
        {
          "type": "format_card",
          "settings": {
            "format_size": "30oz Statement",
            "description": "An elevated centerpiece for open-concept rooms."
          }
