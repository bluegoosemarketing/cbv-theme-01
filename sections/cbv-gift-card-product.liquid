{{ 'section-cbv-gift-card-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cbv-gift-card-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product_form_id = 'cbv-gift-card-product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign current_media = current_variant.featured_media | default: product.featured_media
-%}

<section class="cbv-gc" data-cbv-gift-card-product data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="cbv-gc__layout">
      
      <!-- LEFT: VISUAL PANEL -->
      <div class="cbv-gc__media-col">
        <div class="cbv-gc__media-wrapper">
          <div class="cbv-gc__media-badge">Digital Gift Card</div>
          {% if current_media %}
            {{
              current_media
              | image_url: width: 1200
              | image_tag:
                class: 'cbv-gc__image',
                loading: 'eager',
                widths: '480, 760, 980, 1200'
            }}
          {% else %}
            {{ 'gift-card' | placeholder_svg_tag: 'cbv-gc__image cbv-placeholder' }}
          {% endif %}
        </div>
      </div>

      <!-- RIGHT: CONTENT & FORM -->
      <div class="cbv-gc__content-col">
        <div class="cbv-gc__header">
          {% if section.settings.eyebrow != blank %}
            <p class="cbv-gc__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}
          
          <div class="cbv-gc__title-wrap">
            <h1 class="cbv-gc__title">{{ product.title | escape }}</h1>
            <div class="cbv-gc__price" data-cbv-price>
              {{ current_variant.price | money_without_trailing_zeros }}
            </div>
          </div>

          {% if section.settings.supporting_text != blank %}
            <p class="cbv-gc__supporting">{{ section.settings.supporting_text }}</p>
          {% endif %}
          
          {% if product.description != blank %}
            <div class="cbv-gc__description">{{ product.description }}</div>
          {% endif %}
        </div>

        <product-form class="cbv-gc__form-wrapper" data-section-id="{{ section.id }}">
          {%- form 'product', product, id: product_form_id, class: 'cbv-gc__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-cbv-variant-id>

            {% unless product.has_only_default_variant %}
              <div class="cbv-gc__variants">
                {% for option in product.options_with_values %}
                  <div class="cbv-gc__option-group">
                    <div class="cbv-gc__option-label">Select {{ option.name }}</div>

                    {% if forloop.first %}
                      <!-- Beautiful Grid Selectors for primary option (Denomination) -->
                      <div class="cbv-gc__variant-grid" role="radiogroup" aria-label="{{ option.name | escape }}">
                        {% for value in option.values %}
                          <label class="cbv-gc__variant-btn{% if option.selected_value == value %} is-active{% endif %}" data-cbv-price-card>
                            <input
                              type="radio"
                              name="cbv_option_{{ option.position }}"
                              value="{{ value | escape }}"
                              class="cbv-gc__visually-hidden"
                              data-cbv-option-input
                              data-option-position="{{ option.position }}"
                              {% if option.selected_value == value %}checked{% endif %}
                            >
                            <span>{{ value }}</span>
                          </label>
                        {% endfor %}
                      </div>
                    {% else %}
                      <!-- Dropdown fallback for secondary options -->
                      <div class="cbv-gc__select-wrap">
                        <select
                          class="cbv-gc__select"
                          data-cbv-option-input
                          data-option-position="{{ option.position }}"
                        >
                          {% for value in option.values %}
                            <option value="{{ value | escape }}" {% if value == option.selected_value %}selected{% endif %}>
                              {{ value }}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            {% endunless %}

            {% if product.gift_card? %}
              <div class="cbv-gc__recipient-box">
                {% render 'gift-card-recipient-form', product: product, form: form, section: section %}
              </div>
            {% endif %}

            <button
              type="submit"
              name="add"
              class="cbv-gc__submit-btn"
              {% unless current_variant.available %}disabled{% endunless %}
              data-cbv-submit
            >
              <span data-cbv-submit-text>
                {% if current_variant.available %}
                  {{ section.settings.cta_label }} · {{ current_variant.price | money_without_trailing_zeros }}
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </span>
            </button>
          {%- endform -%}
        </product-form>
      </div>
    </div>
  </div>

  <script type="application/json" data-cbv-variants>
    {{ product.variants | json }}
  </script>
</section>

{% schema %}
{
  "name": "CBV Gift Card",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Candles By Victoria"
    },
    {
      "type": "text",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "A luxe digital gift card for the fragrance lover in your life."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Add to cart label",
      "default": "Add gift card"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "CBV Gift Card"
    }
  ]
}
{% endschema %}

{%- style -%}
  .cbv-gc {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 990px) {
    .cbv-gc {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}