<style>
  :root {
    --font-cbv-heading: "Georgia", "Times New Roman", serif;
    --font-cbv-body: "Avenir Next", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --color-text-dark: #1C1B1A;
    --color-text-light: #666666;
    --color-accent: #3A4D3F;
    --color-surface: #FFFFFF;
    --color-border: #EAEAEC;
    --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  .collections-landing { max-width: 1440px; margin: 0 auto; padding: 80px 40px; }
  .page-header { text-align: center; margin-bottom: 64px; }
  .page-header h1 { font-family: var(--font-cbv-heading); font-size: 56px; font-weight: 400; color: var(--color-text-dark); margin: 0 0 16px 0; letter-spacing: -0.02em; }
  .page-header p { color: var(--color-text-light); font-size: 18px; max-width: 540px; margin: 0 auto; line-height: 1.6; }
  .bento-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 320px; gap: 24px; }
  .bento-item { position: relative; display: block; border-radius: 4px; overflow: hidden; text-decoration: none; background: var(--color-border); isolation: isolate; transition: var(--transition-smooth); }
  .bento-item:hover { box-shadow: 0 20px 40px rgba(28, 27, 26, 0.15); transform: translateY(-4px); }
  .bento-image { position: absolute; top: 0; left: 0; right: 0; bottom: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); z-index: -2; }
  .bento-item:hover .bento-image { transform: scale(1.06); }
  .bento-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(to bottom, rgba(0,0,0,0) 30%, rgba(0,0,0,0.6) 100%); transition: var(--transition-smooth); z-index: -1; }
  .bento-item:hover .bento-overlay { background: linear-gradient(to bottom, rgba(0,0,0,0.1) 10%, rgba(0,0,0,0.8) 100%); }
  .bento-content { position: absolute; bottom: 0; left: 0; right: 0; padding: 32px; z-index: 1; display: flex; flex-direction: column; gap: 6px; }
  .bento-eyebrow { font-family: var(--font-cbv-body); color: rgba(255, 255, 255, 0.85); font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 4px; }
  .bento-title { font-family: var(--font-cbv-heading); color: #FFFFFF; font-weight: 400; margin: 0; letter-spacing: 0.01em; transition: var(--transition-smooth); }
  .item-large .bento-title { font-size: 48px; }
  .item-wide .bento-title { font-size: 36px; }
  .item-standard .bento-title { font-size: 24px; }
  .item-standard .bento-content { padding: 24px; }
  .bento-link { color: #FFFFFF; font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.15em; opacity: 0; transform: translateY(12px); transition: var(--transition-smooth); display: flex; align-items: center; gap: 8px; margin-top: 8px; }
  .bento-item:hover .bento-link { opacity: 1; transform: translateY(0); }
  .bento-link::after { content: "→"; transition: transform 0.3s ease; }
  .bento-item:hover .bento-link::after { transform: translateX(6px); }

  /* Base Grid Sizes assigned by Schema */
  .item-large { grid-column: span 2; grid-row: span 2; }
  .item-wide { grid-column: span 2; grid-row: span 1; }
  .item-standard { grid-column: span 1; grid-row: span 1; }

  @media (max-width: 1024px) {
    .page-header h1 { font-size: 48px; }
    .bento-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 280px; }
    .item-large { grid-column: span 2; grid-row: span 2; }
    .item-wide { grid-column: span 2; grid-row: span 1; }
    .item-standard { grid-column: span 1; grid-row: span 1; }
    .item-large .bento-title { font-size: 40px; }
  }
  @media (max-width: 768px) {
    .collections-landing { padding: 40px 20px; }
    .page-header { margin-bottom: 40px; }
    .page-header h1 { font-size: 36px; }
    .bento-grid { grid-template-columns: 1fr; grid-auto-rows: auto; gap: 16px; }
    .bento-item { grid-column: span 1 !important; grid-row: span 1 !important; }
    .item-large { height: 400px; }
    .item-wide { height: 300px; }
    .item-standard { height: 250px; }
    .item-large .bento-title { font-size: 32px; }
    .item-wide .bento-title { font-size: 28px; }
    .bento-content { padding: 24px; }
  }
  @media (hover: none) {
    .bento-link { opacity: 1; transform: translateY(0); }
    .bento-overlay { background: linear-gradient(to bottom, rgba(0,0,0,0.1) 20%, rgba(0,0,0,0.7) 100%); }
  }
</style>

<section class="collections-landing">
  <header class="page-header">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
  </header>

  <div class="bento-grid">
    {% for block in section.blocks %}
      {% liquid
        assign collection = block.settings.collection
        assign card_title = block.settings.custom_title | default: collection.title
        assign card_image = block.settings.custom_image | default: collection.image
        assign card_link = collection.url | default: '#'
        assign eyebrow = block.settings.eyebrow_text
        assign cta = block.settings.cta_text
      %}
      <a
        href="{{ card_link }}"
        class="bento-item {{ block.settings.card_size }}"
        id="collections-bento-item-{{ block.id }}"
        data-index="{{ forloop.index }}"
        {{ block.shopify_attributes }}
      >
        {% if card_image != blank %}
          {{ card_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'bento-image', sizes: '(min-width: 1024px) 50vw, 100vw', widths: '400,600,800,1000,1200', alt: card_title }}
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'bento-image' }}
        {% endif %}
        <div class="bento-overlay"></div>
        <div class="bento-content">
          {% if eyebrow != blank %}
            <span class="bento-eyebrow">{{ eyebrow }}</span>
          {% endif %}
          <h2 class="bento-title">{{ card_title | default: 'Collection' }}</h2>
          {% if cta != blank %}
            <span class="bento-link">{{ cta }}</span>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collections Bento",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Design your own signature fragrance..."
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title"
        },
        {
          "type": "text",
          "id": "eyebrow_text",
          "label": "Eyebrow text",
          "default": "Specialty Collection"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Shop Now"
        },
        {
          "type": "select",
          "id": "card_size",
          "label": "Card size",
          "default": "item-standard",
          "options": [
            {
              "value": "item-large",
              "label": "Large Square (2x2)"
            },
            {
              "value": "item-wide",
              "label": "Wide Rectangle (2x1)"
            },
            {
              "value": "item-standard",
              "label": "Standard Square (1x1)"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "Collections Bento",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}
